{
    "name": "email-mcp",
    "version": "0.4.1",
    "type": "server",
    "runtime": "python",
    "entry_point": "src/email_mcp/server.py",
    "dependencies": [
        "fastmcp>=3.2.0,<4"
    ],
    "build": {
        "include": [
            "src/**/*",
            "README.md",
            "LICENSE"
        ],
        "exclude": [
            "tests/",
            ".git/",
            "__pycache__/",
            "*.pyc",
            ".venv/",
            "dist/",
            "build/",
            "target/",
            "docs/",
            "scripts/"
        ]
    },
    "scripts": {
        "build": "uv run python build_mcpb.py",
        "pack": "uv run python build_mcpb.py",
        "test": "python -m pytest"
    }
}

# email-mcp environment configuration
# Copy to .env and fill in your credentials

# Default SMTP/IMAP service (your primary email account)
SMTP_SERVER=smtp.example.com
SMTP_PORT=587
SMTP_USER=you@example.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=you@example.com
IMAP_SERVER=imap.example.com
IMAP_PORT=993
IMAP_USER=you@example.com
IMAP_PASSWORD=your-app-password

# Optional: Additional email services as JSON (SendGrid, Mailgun, Resend, etc.)
# EMAIL_SERVICES=[{"name":"sendgrid","type":"api","enabled":true,"config":{"api_key":"...","from_email":"..."}}]

# OAuth2 for Microsoft accounts (personal Outlook/Hotmail have basic auth disabled).
# Default: Microsoft's public Graph client ID — no Azure app registration needed.
# Then connect once via webapp Settings -> Outlook OAuth -> "Graph (Mail API)" (device-code flow).
# When a Graph token exists, the "default" service is backed by Graph automatically.
EMAIL_MCP_OAUTH_CLIENT_ID=14d82eec-204b-4c2f-b7e8-296a70dab67e
# EMAIL_MCP_OAUTH_SCOPE=https://outlook.office.com/IMAP.AccessAsUser.All https://outlook.office.com/SMTP.Send offline_access
# EMAIL_MCP_OAUTH_TOKEN_FILE=data/oauth_tokens.json

# Optional: Mailing lists preset (JSON array)
# EMAIL_MCP_MAILING_LISTS=[{"id":"newsletter","service":"default","folder":"INBOX/Newsletter","limit":10}]

# Optional: Mailing lists file path
# EMAIL_MCP_MAILING_LISTS_FILE=

# AI features (optional — for suggest_email_subject, agentic_assist, auto-respond)
# AI_PROVIDER=ollama
# AI_MODEL=llama3:8b
# AI_ENDPOINT=http://localhost:11434
# ANTHROPIC_API_KEY=sk-ant-...

# Fleet connectors (opt-in: set a URL to enable that connector)
# EMAIL_MCP_AIWATCHER_URL=http://127.0.0.1:10946
# EMAIL_MCP_AIWATCHER_KEY=          # required only if AIWATCHER_API_KEY is set on aiwatcher
# EMAIL_MCP_ROBOFANG_URL=http://127.0.0.1:10871

# Optional API service keys (auto-detected from env)
# SENDGRID_API_KEY=
# SENDGRID_FROM_EMAIL=
# MAILGUN_API_KEY=
# MAILGUN_DOMAIN=
# MAILGUN_FROM_EMAIL=
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=

# ProtonMail Bridge detection
# EMAIL_MCP_PROTON_BRIDGE_HOST=127.0.0.1

# MailHog (local testing — auto-detected from env)
# MAILHOG_SMTP_HOST=localhost
# MAILHOG_SMTP_PORT=1025

{
  "examples": [
    {
      "title": "Send Basic Email",
      "description": "Send a simple text email via the default service",
      "code": "send_email(to=\"user@example.com\", subject=\"Hello\", body=\"Test message\")",
      "category": "sending"
    },
    {
      "title": "Send HTML Email",
      "description": "Send with HTML content and a specific service",
      "code": "send_email(to=\"user@example.com\", subject=\"Welcome\", body=\"Text fallback\", html=\"<h1>Welcome!</h1>\", service=\"sendgrid\")",
      "category": "sending"
    },
    {
      "title": "Send with CC/BCC",
      "description": "Include carbon copy recipients",
      "code": "send_email(to=\"primary@example.com\", cc=[\"manager@example.com\"], subject=\"Update\", body=\"Team update\")",
      "category": "sending"
    },
    {
      "title": "Send via Slack",
      "description": "Post email as Slack message",
      "code": "send_email(to=\"#general\", subject=\"Alert\", body=\"CPU at 90%\", service=\"slack\")",
      "category": "webhooks"
    },
    {
      "title": "Check Inbox",
      "description": "Get unread emails",
      "code": "check_inbox(limit=10, unread_only=True)",
      "category": "receiving"
    },
    {
      "title": "Check Specific Folder",
      "description": "Get emails from Sent folder",
      "code": "check_inbox(folder=\"Sent\", limit=5)",
      "category": "receiving"
    },
    {
      "title": "Filter by Sender",
      "description": "Find emails from a specific sender",
      "code": "check_inbox(from_contains=\"github.com\", limit=20)",
      "category": "receiving"
    },
    {
      "title": "Filter by Subject",
      "description": "Find emails with keywords in subject",
      "code": "check_inbox(subject_contains=\"invoice\", limit=20)",
      "category": "receiving"
    },
    {
      "title": "Get Email Detail",
      "description": "Fetch full email with body",
      "code": "fetch_email_detail(email_id=\"12345\", service=\"default\", folder=\"INBOX\")",
      "category": "receiving"
    },
    {
      "title": "Search Emails",
      "description": "Full-text search across subject and body",
      "code": "search_emails(query=\"deployment\", service=\"default\", folder=\"INBOX\", limit=20)",
      "category": "receiving"
    },
    {
      "title": "Delete Email",
      "description": "Move email to Trash",
      "code": "delete_email(email_id=\"12345\", service=\"default\", folder=\"INBOX\")",
      "category": "management"
    },
    {
      "title": "Mark Email as Read",
      "description": "Set the SEEN flag",
      "code": "mark_email_read(email_id=\"12345\", service=\"default\", folder=\"INBOX\")",
      "category": "management"
    },
    {
      "title": "List Services",
      "description": "Show all configured email services",
      "code": "list_services()",
      "category": "management"
    },
    {
      "title": "Check Service Health",
      "description": "Test connectivity for all services",
      "code": "email_status()",
      "category": "management"
    },
    {
      "title": "Configure Gmail",
      "description": "Add Gmail SMTP/IMAP with App Password",
      "code": "configure_service(name=\"gmail\", type=\"smtp\", config={\"smtp_server\":\"smtp.gmail.com\",\"smtp_port\":587,\"smtp_user\":\"user@gmail.com\",\"smtp_password\":\"app-password\",\"imap_server\":\"imap.gmail.com\",\"imap_port\":993})",
      "category": "management"
    },
    {
      "title": "Configure SendGrid",
      "description": "Add SendGrid transactional email",
      "code": "configure_service(name=\"sendgrid\", type=\"api\", config={\"api_key\":\"your-key\",\"api_url\":\"https://api.sendgrid.com/v3/mail/send\",\"from_email\":\"noreply@domain.com\",\"service_type\":\"sendgrid\"})",
      "category": "management"
    },
    {
      "title": "Remove Service",
      "description": "Remove a runtime configured service",
      "code": "remove_service(name=\"gmail\")",
      "category": "management"
    },
    {
      "title": "Mailing List Catalog",
      "description": "Show configured newsletter presets",
      "code": "mailing_lists_catalog()",
      "category": "receiving"
    },
    {
      "title": "Mailing List Latest",
      "description": "Get newest messages from a preset",
      "code": "mailing_list_latest(list_id=\"alphasignal\")",
      "category": "receiving"
    },
    {
      "title": "AI Subject Suggestion",
      "description": "Get subject line ideas via MCP sampling",
      "code": "suggest_email_subject(body=\"Your email body text here\")",
      "category": "ai"
    },
    {
      "title": "AI Email Workflow",
      "description": "Plan a multi-step email task",
      "code": "email_agentic_assist(goal=\"Clean up my inbox and reply to urgent messages\")",
      "category": "ai"
    }
